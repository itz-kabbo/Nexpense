<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="spend.db" />
        <include domain="database" path="mote.db" />
        <include domain="file" path="datastore/spend_settings.preferences_pb" />
        <include domain="file" path="datastore/mote_settings.preferences_pb" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="spend.db" />
        <include domain="database" path="mote.db" />
        <include domain="file" path="datastore/spend_settings.preferences_pb" />
        <include domain="file" path="datastore/mote_settings.preferences_pb" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
